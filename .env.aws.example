SPRING_PROFILES_ACTIVE=aws
PORT=8080
R2DBC_URL=r2dbc:postgresql://REPLACE_RDS_HOST:5432/authdb
FLYWAY_JDBC_URL=jdbc:postgresql://REPLACE_RDS_HOST:5432/authdb
FLYWAY_ENABLED=true
DB_USERNAME=REPLACE_DB_USERNAME
DB_PASSWORD=REPLACE_DB_PASSWORD
DB_POOL_MAX_SIZE=20
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_32_PLUS_CHARS
JWT_EXPIRATION_SECONDS=3600
JWT_ISSUER=agroventa-auth-service

